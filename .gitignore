/target
**/*.rs.bk
*.profraw

# Fuzzing: the corpus and crash artefacts are large and machine-generated. Crashers
# that matter are promoted into `tests/regression/` as committed fixtures instead,
# so a reproducer never lives only in an ignored directory.
/fuzz/target
/fuzz/Cargo.lock
/fuzz/artifacts
/fuzz/corpus

# Comparison-harness output: renders, diffs and heatmaps are regenerated on demand.
/target/pdfref
/corpus-cache

# The specifications this project is written against, and the Markdown conversion of them
# that the citation checker reads. Free to obtain from the PDF Association, not free to
# redistribute — so they are kept out of the repository and out of its history (ADR 0187),
# and a developer's own copies live here untracked. NOTICE section 3.
/doc/*.pdf
/doc/md/

# Claude Code local settings (per-user, not shared).
.claude/settings.local.json

# A local checkout of another renderer, kept beside the tree for comparison and not
# vendored into it: 93 218 lines of third-party source with C, CUDA and Vulkan
# dependencies this project does not take. What was measured from it is in ADR 0136,
# which is the part that has to survive the directory being deleted.
/doc/rasterrocket
