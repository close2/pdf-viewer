<?xml version="1.0" encoding="utf-8"?>
<!-- The panel navigation, page area and status line. The page area delegates its controls
     and popup notes to their native helpers; panels are read only while the pane is open. -->
<Window
    x:Class="Quorra.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Quorra.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="PermissionsButton" Grid.Row="0" Content="Permissions" Margin="8,4" />
        <NavigationView x:Name="Navigation" Grid.Row="1" IsPaneOpen="False"
            PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
            OpenPaneLength="280">
            <NavigationView.PaneCustomContent>
                <StackPanel>
                    <ComboBox x:Name="PanelChoice" Margin="8" HorizontalAlignment="Stretch" />
                    <ListView x:Name="PanelRows" IsItemClickEnabled="True" SelectionMode="None" />
                </StackPanel>
            </NavigationView.PaneCustomContent>
        <local:PageArea
            x:Name="Area"
            Grid.Row="0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            SizeChanged="OnPageSizeChanged"
            KeyDown="OnPageKeyDown"
            PointerPressed="OnPagePointerPressed"
            PointerMoved="OnPagePointerMoved"
            PointerReleased="OnPagePointerReleased"
            PointerWheelChanged="OnPageWheel" />
        </NavigationView>
        <TextBlock
            x:Name="StatusLine"
            Grid.Row="2"
            Margin="8,4"
            TextTrimming="CharacterEllipsis"
            IsTextSelectionEnabled="True" />
    </Grid>
</Window>
