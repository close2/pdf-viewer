<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C ABI of crates/viewer-ffi for a .NET host (RFC 0010 step N0, ADR 2054). It names no
    Windows type, so it builds wherever a .NET SDK does. No gate of the tree builds it: the machine
    the gates run on has no SDK, and `dotnet build` is CI's `interop` job (ADR 2073).
    crates/viewer-ffi/tests/header_and_interop_agree.rs is what holds it to the header before then.
  -->
  <PropertyGroup>
    <!-- The long-term-support release in force; .NET 8's support ends in November 2026. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Quorra.Interop</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibraryImport's generated stubs and the declarations' pointers both need it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every declaration is internal (Native.cs), and the WinUI window is the one assembly that
         calls them, from its QuorraWindow.cs alone (RFC 0010 step N3a, ADR 2136). -->
    <InternalsVisibleTo Include="Quorra.App" />
  </ItemGroup>

</Project>
