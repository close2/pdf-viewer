#!/bin/sh
# The suite's adapter protocol (README.md) answered by this program: pages drawn by
# `quorra-transform render` (the oracle rasteriser, render-cpu), text and questions by
# `portable-adapter`. Both are found on PATH, or in $QUORRA_BIN when it is set.
set -eu
bin=${QUORRA_BIN:+$QUORRA_BIN/}
request=$1; pdf=$2
case "$request" in
render)
    page=$(( $3 + 1 )); out=$5
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    "${bin}quorra-transform" render "$pdf" --pages "$page" --dpi "$4" -o "$dir/page-%d.png" >/dev/null
    mv "$dir/page-$page.png" "$out" ;;
text|query)
    exec "${bin}portable-adapter" "$@" ;;
*) exit 3 ;;
esac
